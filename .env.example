# --- Database (Neon or Supabase free tier) ---
# Get this from your Neon or Supabase project dashboard.
# Use the "pooled connection" string if offered (serverless-friendly).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-generated-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe (test mode keys — free) ---
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
